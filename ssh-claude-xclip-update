#!/usr/bin/env bash
# ssh-claude-xclip-update — 하위 호환 shim.
#
# 설치/갱신 로직은 전부 `ssh-claude-xclip` CLI로 옮겼다. 이 파일은 예전 안내문의
# curl 한 줄을 북마크해둔 사람들이 깨지지 않게 남겨둔 것뿐이다.
# 설치 후에는 `ssh-claude-xclip update` 를 쓰면 된다 (curl 불필요).
set -euo pipefail

REPO="${SSH_CLAUDE_XCLIP_REPO:-https://github.com/popupstudio-sooakim/ssh-claude-xclip.git}"
if [ "$(uname)" = "Darwin" ]; then
  SRC="${SSH_CLAUDE_XCLIP_HOME:-$HOME/.ssh-claude-xclip}"
else
  SRC="${SSH_CLAUDE_XCLIP_HOME:-$HOME/ssh-claude-xclip}"
fi

if [ -d "$SRC/.git" ]; then
  git -C "$SRC" pull -q --ff-only
else
  mkdir -p "$(dirname "$SRC")"
  git clone -q "$REPO" "$SRC"
fi

exec bash "$SRC/ssh-claude-xclip" install
