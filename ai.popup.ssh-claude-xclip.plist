<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.popup.ssh-claude-xclip</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOURNAME/bin/ssh-claude-xclip-mac.py</string>
  </array>
  <!-- launchd 에이전트는 셸 환경을 상속하지 않는다. 터미널에서 export 해봐야 데몬엔 안 닿으므로
       설정은 반드시 여기서 준다. 업로드 대상 서버를 바꾸려면 아래 값을 고치고 데몬 재기동:
         launchctl unload ~/Library/LaunchAgents/ai.popup.ssh-claude-xclip.plist
         launchctl load   ~/Library/LaunchAgents/ai.popup.ssh-claude-xclip.plist

       REMOTE 는 쉼표로 여러 개를 줄 수 있다 (예: popup-ubuntu-dev,popup-server).
       같은 서버라도 접속 계정이 다르면 업로드한 /tmp 파일의 주인이 달라진다 —
       데몬은 지금 어느 계정으로 작업 중인지 알 수 없으므로, 쓰는 계정을 전부 적어두면
       어느 쪽으로 붙어도 붙여넣기가 된다. 한 곳이라도 성공하면 그 캡쳐는 성공. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>SSH_CLAUDE_XCLIP_REMOTE</key><string>popup-server</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/ssh-claude-xclip.log</string>
</dict>
</plist>
